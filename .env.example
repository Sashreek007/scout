# Every variable scout's apps read. Copy to .env (gitignored) on the Mac and fill in what you need.
# Never commit a value. In GitHub Actions the secrets come from repository secrets instead.

# Claude API key, for the pipeline and the scout server. Secret.
ANTHROPIC_API_KEY=
# Leave empty for the real API. `pnpm dev` points it at the fake Claude.
ANTHROPIC_BASE_URL=

# scout-dev or scout-prod.
FIREBASE_PROJECT_ID=
# The service account key JSON for the Admin SDK. The most sensitive secret in the project.
FIREBASE_SERVICE_ACCOUNT=

# Set by the Firebase emulator (`pnpm dev`, `pnpm test`). Leave empty to use the real project.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Local dev only: send job-board requests to the fake job board.
SCOUT_BOARD_BASE_URL=
