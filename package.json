{
  "name": "scout",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "firebase emulators:exec --config firebase/firebase.json --project demo-scout --only firestore,auth \"vitest run --coverage\"",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "dev": "firebase emulators:exec --config firebase/firebase.json --project demo-scout --only firestore,auth --ui \"tsx scripts/dev.ts\"",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@scout/core": "workspace:*",
    "@scout/testkit": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "re2"
    ],
    "ignoredBuiltDependencies": [
      "@firebase/util"
    ]
  }
}
