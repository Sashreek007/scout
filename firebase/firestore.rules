rules_version = '2';

// Placeholder until #3 writes the real rules: every client read and write is denied.
// The pipeline and the agent use the Admin SDK, which skips rules, so nothing in phase 0 needs more.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
