<mxfile host="scout-gen"><diagram name="agents" id="agents"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="scout: the supervisor and its agents" style="rounded=0;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="n3" value='&lt;img src="data:image/svg+xml;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px"&gt;&lt;b&gt;Firestore&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=8;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="340" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Approved applications&lt;/b&gt;&lt;br&gt;the queue the supervisor draws from" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="220" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;config/agent and config/models&lt;/b&gt;&lt;br&gt;workers, limits, timeouts, retries,&lt;br&gt;model and account per task" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;agents/{agentId}&lt;/b&gt;&lt;br&gt;live status for the Agents page" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="220" height="50" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;questions&lt;/b&gt;&lt;br&gt;live questions and your answers" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="220" height="50" as="geometry"/></mxCell><mxCell id="n8" value='&lt;img src="data:image/svg+xml;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px"&gt;&lt;b&gt;Temporal, running on the Mac&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=8;fillColor=none;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="520" height="470" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Supervisor workflow&lt;/b&gt;&lt;br&gt;keeps up to N agents busy, picks the next application,&lt;br&gt;per-company and cap limits, restarts failures, handles pause" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="125" width="440" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Each agent is a child workflow&lt;/b&gt;&lt;br&gt;open, fill, read back,&lt;br&gt;ask live, submit once,&lt;br&gt;confirm&lt;br&gt;&lt;br&gt;workflow ID = job key,&lt;br&gt;so never twice" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="170" height="180" as="geometry"/></mxCell><mxCell id="n11" value="Timers wait for answers&lt;br&gt;and pacing. Retries and&lt;br&gt;timeouts per step come&lt;br&gt;from Settings." style="rounded=0;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="190" height="80" as="geometry"/></mxCell><mxCell id="n12" value='&lt;img src="data:image/svg+xml;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px"&gt;&lt;b&gt;Agent 1: Shopify&lt;/b&gt;&lt;br&gt;pacing, next in 1:42' style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="220" height="50" as="geometry"/></mxCell><mxCell id="n13" value='&lt;img src="data:image/png;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px;border-radius:4px;background:#fff"&gt;&lt;b&gt;Agent 2: Clio&lt;/b&gt;&lt;br&gt;filling, step 4 of 9' style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="305" width="220" height="50" as="geometry"/></mxCell><mxCell id="n14" value='&lt;img src="data:image/png;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px;border-radius:4px;background:#fff"&gt;&lt;b&gt;Agent 3: Element Fleet&lt;/b&gt;&lt;br&gt;waiting on you, 8:41' style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FBBF24;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="220" height="50" as="geometry"/></mxCell><mxCell id="n15" value='&lt;img src="data:image/svg+xml;base64," width="18" height="18" style="vertical-align:middle;margin-right:6px"&gt;&lt;b&gt;scout Chrome window&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=8;fillColor=none;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="260" height="240" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Tab: scout 1 · Shopify&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="220" height="50" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Tab: scout 2 · Clio&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="305" width="220" height="50" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Tab: scout 3 · Element Fleet&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="220" height="50" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Notification&lt;/b&gt;&lt;br&gt;Mac app banner or phone push,&lt;br&gt;live question, 10 minutes" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="520" width="220" height="50" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;dashboard or phone" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="610" width="220" height="50" as="geometry"/></mxCell><mxCell id="n21" value="next ap